# weka.conf -- rendered by Ansible from weka_vars.yml. Do not edit by hand;
# edit weka_vars.yml and re-run the playbook.
AWS_REGION="{{ aws_region }}"
CLUSTER_NAME="{{ cluster_name }}"

INSTANCE_TYPE="{{ instance_type }}"
AMI_ID="{{ ami_id }}"
SUBNET_ID="{{ subnet_id }}"
SG_ENA="{{ sg_ena }}"
SG_EFA="{{ sg_efa }}"
INSTANCE_PROFILE_ARN="{{ instance_profile_arn }}"
LAUNCH_TEMPLATE_NAME="{{ launch_template_name }}"
CREATE_IN_AWS=true

EXPECTED_NODES={{ expected_nodes }}
DATA={{ stripe_data }}
PROTECTION={{ stripe_protection }}
HOT_SPARES={{ hot_spares }}

DRIVE_CORES={{ drive_cores }}
COMPUTE_CORES={{ compute_cores }}
FRONTEND_CORES={{ frontend_cores }}

DRIVES_PER_NODE={{ drives_per_node }}
WEKA_CORE_IDS="{{ weka_core_ids }}"
EXCLUDED_CORE_IDS="{{ excluded_core_ids }}"
WEKA_OPT_VOLUME_GB="{{ weka_opt_volume_gb }}"
ROOT_VOLUME_GB={{ root_volume_gb }}

WEKA_INSTALL_S3="{{ weka_install_s3 }}"

# optional overrides -- rendered only when defined in weka_vars.yml
{% if weka_install_url is defined %}WEKA_INSTALL_URL="{{ weka_install_url }}"
{% endif %}{% if mgmt_subnet_id is defined %}MGMT_SUBNET_ID="{{ mgmt_subnet_id }}"
{% endif %}{% if sg_mgmt is defined %}SG_MGMT="{{ sg_mgmt }}"
{% endif %}{% if efa_count is defined %}EFA_COUNT="{{ efa_count }}"
{% endif %}{% if efa_card_start is defined %}EFA_CARD_START={{ efa_card_start }}
{% endif %}{% if drive_ram_per_core_gb is defined %}DRIVE_RAM_PER_CORE_GB={{ drive_ram_per_core_gb }}
{% endif %}{% if compute_ram_per_core_gb is defined %}COMPUTE_RAM_PER_CORE_GB={{ compute_ram_per_core_gb }}
{% endif %}{% if frontend_ram_per_core_gb is defined %}FRONTEND_RAM_PER_CORE_GB={{ frontend_ram_per_core_gb }}
{% endif %}{% if rotate_admin_password is defined %}ROTATE_ADMIN_PASSWORD={{ rotate_admin_password | lower }}
{% endif %}{% if ssm_timeout is defined %}SSM_TIMEOUT={{ ssm_timeout }}
{% endif %}{% if user_data_file is defined %}USER_DATA_FILE="{{ user_data_file }}"
{% endif %}
# greenfield infrastructure -- used only by infra.yml / create-infrastructure.sh
{% if vpc_id is defined %}VPC_ID="{{ vpc_id }}"
{% endif %}{% if account_id is defined %}ACCOUNT_ID="{{ account_id }}"
{% endif %}{% if existing_subnet_id is defined %}EXISTING_SUBNET_ID="{{ existing_subnet_id }}"
{% endif %}{% if subnet_cidr is defined %}SUBNET_CIDR="{{ subnet_cidr }}"
{% endif %}{% if availability_zone_id is defined %}AVAILABILITY_ZONE_ID="{{ availability_zone_id }}"
{% endif %}{% if create_efa_sg is defined %}CREATE_EFA_SG={{ create_efa_sg | lower }}
{% endif %}{% if create_ssm_endpoints is defined %}CREATE_SSM_ENDPOINTS={{ create_ssm_endpoints | lower }}
{% endif %}{% if endpoint_subnet_id is defined %}ENDPOINT_SUBNET_ID="{{ endpoint_subnet_id }}"
{% endif %}{% if route_table_id is defined %}ROUTE_TABLE_ID="{{ route_table_id }}"
{% endif %}
